# Ignore dist folder (build output)
dist/

# Ignore build artifacts
build/
*.spec

# Ignore Python cache
__pycache__/
*.pyc
*.pyo

# Ignore database lock files
*.lock

# Ignore test files and directories
test_*.py
test_files/
previous_versions/

# Ignore temporary files
*.tmp
*.temp

# Allow releases folder to be committed
!releases/

# Ignore company sharing package (temporary)
Company_Share/